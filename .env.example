# Skopiuj do .env (lokalnie) lub ustaw jako GitHub Secrets / zmienne w Task Scheduler.
# NIE commituj .env z prawdziwymi hasłami.

# --- Harmonogram wysyłki (dowolna godzina startu, np. 2:00 w nocy) ---
# Wyłącza okno 8–18 — zalecane dla GitHub Actions i nocnego cron:
DISABLE_SEND_WINDOW=1
# Alternatywnie: cała doba bez wyłączania flagi:
# SEND_WINDOW_START_HOUR=0
# SEND_WINDOW_END_HOUR=24
# Strefa dla okna (gdy DISABLE_SEND_WINDOW=0):
SCRAPER_TIMEZONE=Europe/Warsaw

# --- Poczta (Gmail Hurt Matbud) ---
MAIL_USER=hurtmatbud2@gmail.com
# Puste = odczyt z PowerShell User: GMAIL_APP_PASSWORD (hasło aplikacji)
MAIL_PASSWORD=
MAIL_SENDER_NAME=Hurt Matbud
DISABLE_EMAIL_ATTACHMENT=1
MAX_SEND_PER_RUN=20
# Opcjonalna widoczna kopia:
# MAIL_CC=
# Gmail: smtp.gmail.com wykrywane automatycznie gdy MAIL_USER=@gmail.com


# --- API (puste w .env = odczyt z PowerShell User) ---
# [Environment]::GetEnvironmentVariable("SERPER_API_KEY","User")
# [Environment]::GetEnvironmentVariable("ANTHROPIC_API_KEY","User")
# alias: CLAUDE_API_KEY
SERPER_API_KEY=
ANTHROPIC_API_KEY=

# Ścieżka do bibliotek (polish_text.py, scraper_env)
KANBUD_PROJECT_ROOT=C:\Users\svinc\Documents\Wyszukiwarka partnerow\libs

# Wyniki — folder Google Drive:
# https://drive.google.com/drive/folders/1LdIQi0t1fgQMlHwNnvMdPn5lyv1zOqIJ
# KANBUD_GOOGLE_DRIVE_GU_PATH=

# Google Drive — puste = odczyt z PowerShell User:
# GDRIVE_OAUTH_CLIENT_ID / GDRIVE_OAUTH_CLIENT_SECRET / GDRIVE_OAUTH_REFRESH_TOKEN
# GDRIVE_SERVICE_ACCOUNT_JSON albo GDRIVE_SERVICE_ACCOUNT_FILE
# alias: GOOGLE_APPLICATION_CREDENTIALS
# GDRIVE_SERVICE_ACCOUNT_FILE=secrets/gdrive-service-account.json
# OAuth Desktop: secrets/gdrive-oauth-client.json + python scripts/gdrive_oauth_setup.py

